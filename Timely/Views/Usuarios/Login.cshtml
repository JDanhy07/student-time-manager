@model IEnumerable<Timely.Models.Usuarios>

@{
    ViewData["Title"] = "Login";
}

<style>
    /* ========== ESTILOS EXCLUSIVOS PARA EL LOGIN ========== */
    /* Reseteamos solo lo necesario para esta página */
    body {
        margin: 0 !important;
        padding: 0 !important;
        background: linear-gradient(135deg, #1565C0, #64B5F6) !important;
        font-family: 'Segoe UI', system-ui, sans-serif !important;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Contenedor principal (por si hay algún wrapper) */
    .login-container {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1rem;
        box-sizing: border-box;
    }

    /* Tarjeta blanca: ancho fluido con tope */
    .login-card {
        background: white;
        padding: 2rem 1.5rem;
        border-radius: 1.5rem;
        box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.2);
        width: 100%;
        max-width: 420px;
        transition: all 0.3s ease;
        text-align: center;
        box-sizing: border-box;
    }

    /* Ajuste para pantallas muy pequeñas */
    @@media (max-width: 480px) {
        .login-card

    {
        padding: 1.5rem 1rem;
        border-radius: 1rem;
    }

    }

    /* Campos de formulario */
    .login-card .form-group {
        margin-bottom: 1.2rem;
        text-align: left;
    }

    .login-card label {
        font-weight: 600;
        margin-bottom: 0.3rem;
        display: inline-block;
        color: #333;
    }

    .login-card .form-control {
        border-radius: 40px;
        padding: 0.75rem 1rem;
        border: 1px solid #ccc;
        width: 100%;
        box-sizing: border-box;
        font-size: 1rem;
        transition: border 0.2s;
    }

        .login-card .form-control:focus {
            border-color: #1565C0;
            outline: none;
            box-shadow: 0 0 0 3px rgba(21, 101, 192, 0.2);
        }

    /* Botón de inicio de sesión */
    .login-card .btn-primary {
        background-color: #1565C0;
        border: none;
        border-radius: 40px;
        padding: 0.75rem;
        font-size: 1.1rem;
        font-weight: bold;
        width: 100%;
        color: white;
        cursor: pointer;
        transition: background 0.3s, transform 0.1s;
    }

        .login-card .btn-primary:hover {
            background-color: #0D47A1;
            transform: scale(1.01);
        }

    /* Enlace de registro */
    .login-card .text-link {
        color: #1565C0;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
    }

        .login-card .text-link:hover {
            text-decoration: underline;
            color: #0D47A1;
        }

    /* Mensajes de error */
    .login-card .alert-danger {
        background-color: #ffe6e6;
        color: #b00020;
        border-radius: 30px;
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        text-align: left;
    }

    /* Ocultar el menú principal en esta página */
    #menu {
        display: none !important;
    }

    /* Evitar que el footer fijo se superponga */
    #footer {
        display: none !important;
    }
</style>

<div class="login-container">
    <div class="login-card">
        <h3 class="mb-3">Iniciar sesión</h3>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        }

        <form asp-action="Login">
            <div class="form-group">
                <label>Usuario</label>
                <input type="text" name="usuario" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" name="Contrasena" class="form-control" required />
            </div>

            <div class="text-center mt-4">
                <input type="submit" value="Iniciar sesión" class="btn-primary" />
            </div>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Create" class="text-link">Regístrese Aquí</a>
        </div>
    </div>
</div>