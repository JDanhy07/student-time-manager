@model Timely.Models.ListaUsuariosViewModel

@{
    ViewData["Title"] = "Usuarios";

    // Las rutas de paginación conservan búsqueda, filtro y orden (ver asp-all-route-data más abajo)

    // Páginas a mostrar: primera, última y las cercanas a la actual; "…" en los huecos
    var paginas = new List<int>();
    for (int i = 1; i <= Model.TotalPaginas; i++)
    {
        if (i == 1 || i == Model.TotalPaginas || Math.Abs(i - Model.Pagina) <= 1) paginas.Add(i);
    }
    int desde = (Model.Pagina - 1) * Timely.Models.ListaUsuariosViewModel.TamanoPagina + 1;
    int hasta = desde + Model.Items.Count - 1;
}

<div class="usr-cabecera">
    <div>
        <h1 class="page-title">Usuarios</h1>
        <p class="usr-resumen">
            @Model.Total en total
            <span aria-hidden="true">·</span> @Model.TotalAdministradores administradores
            <span aria-hidden="true">·</span> @Model.TotalEstudiantes estudiantes
        </p>
    </div>
    <a asp-action="CreateLista" class="btn btn-primary">Crear nuevo usuario</a>
</div>

<form method="get" asp-action="Lista" class="usr-filtros" role="search">
    <div class="usr-buscar">
        <label for="q" class="visually-hidden">Buscar usuario</label>
        <input type="text" id="q" name="q" value="@Model.Busqueda" placeholder="Buscar por usuario o correo" autocomplete="off" />
    </div>
    <div>
        <label for="rol" class="visually-hidden">Rol</label>
        <select id="rol" name="rol" class="form-select" onchange="this.form.submit()">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Rol))">Todos los roles</option>
            <option value="Administrador" selected="@(Model.Rol == "Administrador")">Administradores</option>
            <option value="Estudiante" selected="@(Model.Rol == "Estudiante")">Estudiantes</option>
        </select>
    </div>
    <div>
        <label for="orden" class="visually-hidden">Ordenar por</label>
        <select id="orden" name="orden" class="form-select" onchange="this.form.submit()">
            <option value="nombre" selected="@(Model.Orden == "nombre")">Nombre (A-Z)</option>
            <option value="recientes" selected="@(Model.Orden == "recientes")">Más recientes</option>
            <option value="antiguos" selected="@(Model.Orden == "antiguos")">Más antiguos</option>
        </select>
    </div>
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
    @if (Model.HayFiltros)
    {
        <a asp-action="Lista" class="usr-limpiar">Limpiar</a>
    }
</form>

@if (Model.Items.Count == 0)
{
    <div class="usr-vacio">
        <p>@(Model.HayFiltros ? "Ningún usuario coincide con tu búsqueda." : "Todavía no hay usuarios registrados.")</p>
        @if (Model.HayFiltros)
        {
            <a asp-action="Lista" class="btn btn-outline-primary btn-sm">Ver todos</a>
        }
    </div>
}
else
{
    <p class="usr-conteo" aria-live="polite">Mostrando @desde–@hasta de @Model.TotalFiltrado</p>

    <ul class="usr-lista">
        @foreach (var item in Model.Items)
        {
            var inicial = string.IsNullOrEmpty(item.Usuario) ? "?" : item.Usuario.Substring(0, 1).ToUpperInvariant();
            var esAdmin = item.Rol == "Administrador";
            <li class="usr-fila">
                <span class="usr-avatar" aria-hidden="true">@inicial</span>
                <div class="usr-datos">
                    <span class="usr-nombre">@item.Usuario</span>
                    <a class="usr-correo" href="mailto:@item.Correo">@item.Correo</a>
                </div>
                <span class="usr-rol @(esAdmin ? "usr-rol-admin" : "usr-rol-estudiante")">@item.Rol</span>
                <span class="usr-fecha" title="Fecha registrada">@item.Fecha</span>
                <div class="usr-acciones">
                    @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-outline-primary btn-sm" })
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-outline-danger btn-sm" })
                </div>
            </li>
        }
    </ul>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="usr-paginas" aria-label="Paginación de usuarios">
            @if (Model.Pagina > 1)
            {
                <a asp-action="Lista" asp-all-route-data="@(new Dictionary<string, string?> {
                    ["q"] = Model.Busqueda, ["rol"] = Model.Rol, ["orden"] = Model.Orden, ["pagina"] = (Model.Pagina - 1).ToString() })">&larr; Anterior</a>
            }
            @for (int i = 0; i < paginas.Count; i++)
            {
                var n = paginas[i];
                if (i > 0 && n - paginas[i - 1] > 1) { <span class="usr-puntos">…</span> }
                if (n == Model.Pagina)
                {
                    <span class="usr-pag-actual" aria-current="page">@n</span>
                }
                else
                {
                    <a asp-action="Lista" asp-all-route-data="@(new Dictionary<string, string?> {
                        ["q"] = Model.Busqueda, ["rol"] = Model.Rol, ["orden"] = Model.Orden, ["pagina"] = n.ToString() })">@n</a>
                }
            }
            @if (Model.Pagina < Model.TotalPaginas)
            {
                <a asp-action="Lista" asp-all-route-data="@(new Dictionary<string, string?> {
                    ["q"] = Model.Busqueda, ["rol"] = Model.Rol, ["orden"] = Model.Orden, ["pagina"] = (Model.Pagina + 1).ToString() })">Siguiente &rarr;</a>
            }
        </nav>
    }
}