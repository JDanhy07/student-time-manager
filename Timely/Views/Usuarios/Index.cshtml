@using System.Globalization
@model Timely.Models.HogarDashboardViewModel

@{
    ViewData["Title"] = "Inicio";

    var es = new CultureInfo("es-CR");
    var hoy = DateTime.Today;

    string Etiqueta(DateTime d) =>
        d.Date == hoy ? "Hoy" : d.Date == hoy.AddDays(1) ? "Mañana" : "";

    string Horario(Timely.Models.EventoResumen ev)
    {
        bool todoDia = ev.Inicio.TimeOfDay == TimeSpan.Zero
                       && ev.Fin.HasValue && ev.Fin.Value.TimeOfDay >= new TimeSpan(23, 59, 0);
        if (todoDia) return "Todo el día";
        var texto = ev.Inicio.ToString("HH:mm");
        if (ev.Fin.HasValue) texto += " – " + ev.Fin.Value.ToString("HH:mm");
        return texto;
    }

    var saludo = Model.Saludo + (string.IsNullOrWhiteSpace(Model.NombreUsuario) ? "" : ", " + Model.NombreUsuario);
}

<div class="dash">

    <!-- Saludo -->
    <section class="dash-hero">
        <h1>@saludo 👋</h1>
        <p>@Model.FechaHoy</p>

        <div class="dash-stats">
            <div class="dash-stat">
                <strong>@Model.EventosHoy</strong>
                <span>@(Model.EventosHoy == 1 ? "evento hoy" : "eventos hoy")</span>
            </div>
            <div class="dash-stat">
                <strong>@Model.EventosSemana</strong>
                <span>próximos 7 días</span>
            </div>
        </div>
    </section>

    <!-- Accesos rápidos -->
    <section class="dash-actions">
        <a class="dash-action" asp-controller="Calendarios" asp-action="Index" asp-route-nuevo="1">
            <span class="dash-action-icon">📅</span> Nuevo evento
        </a>
        <a class="dash-action" asp-controller="Notas" asp-action="Create">
            <span class="dash-action-icon">📝</span> Nueva nota
        </a>
        <a class="dash-action" asp-controller="Proyectos" asp-action="Create">
            <span class="dash-action-icon">📁</span> Nuevo proyecto
        </a>
    </section>

    <div class="dash-grid">

        <!-- Próximos eventos -->
        <section class="dash-card">
            <div class="dash-card-header">
                <h2>Próximos eventos</h2>
                <a class="dash-link" asp-controller="Calendarios" asp-action="Index">Ver calendario →</a>
            </div>

            @if (Model.ProximosEventos.Any())
            {
                foreach (var ev in Model.ProximosEventos)
                {
                    var etiqueta = Etiqueta(ev.Inicio);
                    <div class="dash-evento">
                        <div class="dash-fecha-badge">
                            <strong>@ev.Inicio.Day</strong>
                            <span>@ev.Inicio.ToString("MMM", es).TrimEnd('.')</span>
                        </div>
                        <div class="dash-evento-info">
                            <div class="dash-evento-titulo">@ev.Titulo</div>
                            <div class="dash-evento-hora">🕓 @Horario(ev)</div>
                        </div>
                        @if (etiqueta == "Hoy")
                        {
                            <span class="dash-tag dash-tag-hoy">Hoy</span>
                        }
                        else if (etiqueta == "Mañana")
                        {
                            <span class="dash-tag dash-tag-manana">Mañana</span>
                        }
                    </div>
                }
            }
            else
            {
                <div class="dash-vacio">
                    <div class="dash-vacio-icono">🎉</div>
                    <div>No tienes eventos próximos.</div>
                    <a class="btn btn-primary mt-3" asp-controller="Calendarios" asp-action="Index" asp-route-nuevo="1">Crear un evento</a>
                </div>
            }
        </section>

        <!-- Columna derecha -->
        <div class="dash-col">
            <section class="dash-card">
                <div class="dash-card-header">
                    <h2>Notas</h2>
                </div>
                <p>Guarda apuntes e ideas importantes organizados por carpeta.</p>
                <a class="btn btn-outline-primary btn-sm" asp-controller="Notas" asp-action="Index">Ir a mis notas</a>
            </section>

            <section class="dash-card">
                <div class="dash-card-header">
                    <h2>Proyectos</h2>
                </div>
                <p>Da seguimiento a tus entregas y fechas límite.</p>
                <a class="btn btn-outline-primary btn-sm" asp-controller="Proyectos" asp-action="Index">Ir a mis proyectos</a>
            </section>
        </div>

    </div>

    <!-- Consejo (reutiliza tu imagen y el mensaje original, en versión corta) -->
    <section class="dash-card dash-tip">
        <img src="~/img/importancia.jpg" alt="Importancia de gestionar el tiempo" />
        <div>
            <h2>¿Por qué gestionar tu tiempo?</h2>
            <p>Organizar tus horas reduce el estrés y te da claridad para avanzar en tus metas académicas y personales. Cada minuto cuenta: empieza hoy planificando tu semana.</p>
        </div>
    </section>

</div>
