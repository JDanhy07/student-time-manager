@model IEnumerable<Timely.Models.Nota>

@{
    ViewData["Title"] = "Mis Notas";
}

<!-- Vincular el CSS -->
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

<div class="container">
    <h1>Mis Notas</h1>
    <p><a asp-action="Create" class="btn btn-primary">Crear nueva nota</a></p>

    @if (!Model.Any())
    {
        <section class="vacio-total">
            <span class="vacio-icono"><partial name="_Icono" model='"nota"' /></span>
            <h2>Todavía no tienes notas</h2>
            <p>Guarda aquí tus apuntes e ideas importantes, organizados por carpeta.</p>
            <a asp-action="Create" class="btn btn-primary">Crear mi primera nota</a>
        </section>
    }
    else
    {
        foreach (var grupo in Model.GroupBy(n => n.Carpeta))
        {
            <div class="folder">
                <h2 class="folder-title">@grupo.Key</h2> <!-- Nombre de la Carpeta -->
                @foreach (var item in grupo)
                {
                    <div class="note-card">
                        <div class="blockquote-footer">@Html.DisplayFor(modelItem => item.Titulo)</div>
                        <div class="note-content">@Html.DisplayFor(modelItem => item.Contenido)</div>
                        <div class="actions">
                            @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-outline-primary btn-sm" })
                            @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-outline-danger btn-sm" })
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>