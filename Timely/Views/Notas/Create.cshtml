@model Timely.Models.Nota

@{
    ViewData["Title"] = "Crear Nota";
}

<link rel="stylesheet" href="~/css/style.css">

<div class="create-container">
    <div class="form-card">
        <h2>Crear nueva nota</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <label asp-for="Titulo">Título</label>
            <input asp-for="Titulo" type="text" placeholder="Escribe un título" required>

            <label asp-for="Contenido">Contenido</label>
            <textarea asp-for="Contenido" rows="4" placeholder="Escribe tu nota aquí" required></textarea>

            <label asp-for="Carpeta">Carpeta</label>
            <input asp-for="Carpeta" type="text" placeholder="Nombre de la carpeta" required>

            <button type="submit">Guardar Nota</button>
        </form>
    </div>

    <a asp-action="MisNotas" class="back-link">← Volver a la lista</a>
</div>

