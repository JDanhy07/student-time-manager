@{
    // Datos para marcar la página activa y mostrar el menú de usuario
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var autenticado = User.Identity?.IsAuthenticated == true;
    var nombre = User.Identity?.Name ?? "";
    var inicial = nombre.Length > 0 ? char.ToUpper(nombre[0]).ToString() : "?";

    bool EnControlador(string c) => string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase);
    bool EnAccion(params string[] acciones) => acciones.Any(a => string.Equals(accion, a, StringComparison.OrdinalIgnoreCase));

    bool enInicio = EnControlador("Usuarios") && EnAccion("Index");
    bool enUsuarios = EnControlador("Usuarios") && EnAccion("Lista", "CreateLista", "Edit", "Delete");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f3a5f" />
    <title>@ViewData["Title"] - Timely</title>
    <link rel="preload" href="~/fonts/newsreader-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <header class="app-bar">
        <div class="app-bar-inner">
            <a class="brand" asp-controller="Usuarios" asp-action="Index">
                <span class="brand-mark"><partial name="_Icono" model='"clock"' /></span>Timely
            </a>

            @if (autenticado)
            {
                <nav id="navPrincipal" class="app-nav collapse d-md-flex" aria-label="Principal">
                    <a asp-controller="Usuarios" asp-action="Index" class="@(enInicio ? "activo" : "")" aria-current="@(enInicio ? "page" : null)">Inicio</a>
                    <a asp-controller="Proyectos" asp-action="Tablero" class="@(EnControlador("Proyectos") ? "activo" : "")" aria-current="@(EnControlador("Proyectos") ? "page" : null)">Proyectos</a>
                    <a asp-controller="Notas" asp-action="MisNotas" class="@(EnControlador("Notas") ? "activo" : "")" aria-current="@(EnControlador("Notas") ? "page" : null)">Notas</a>
                    <a asp-controller="Calendarios" asp-action="Index" class="@(EnControlador("Calendarios") ? "activo" : "")" aria-current="@(EnControlador("Calendarios") ? "page" : null)">Calendario</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-controller="Usuarios" asp-action="Lista" class="@(enUsuarios ? "activo" : "")" aria-current="@(enUsuarios ? "page" : null)">Usuarios</a>
                    }
                </nav>

                <div class="app-bar-end">
                    <div class="dropdown">
                        <button type="button" class="user-btn" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar">@inicial</span>
                            <span class="user-name">@nombre</span>
                            <partial name="_Icono" model='"chevron"' />
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="MiPerfil">Mi perfil</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Usuarios" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                    <button type="button" class="nav-toggle d-md-none" data-bs-toggle="collapse" data-bs-target="#navPrincipal" aria-controls="navPrincipal" aria-expanded="false" aria-label="Mostrar menú">
                        <partial name="_Icono" model='"menu"' />
                    </button>
                </div>
            }
            else
            {
                <div class="app-bar-end">
                    <a class="btn btn-primary btn-sm" asp-controller="Usuarios" asp-action="Login">Iniciar sesión</a>
                </div>
            }
        </div>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
